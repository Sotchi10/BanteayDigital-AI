# Application runtime
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Internal service authentication. Required when ENVIRONMENT=production.
AI_SERVICE_API_KEY=replace-with-a-long-random-secret

# Future vector knowledge base configuration.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scam_knowledge_v1
# Matches below this cosine similarity are excluded. Production defaults to
# verified records only; set false only for local synthetic test data.
RETRIEVAL_MIN_SCORE=0.70
RETRIEVAL_VERIFIED_ONLY=false

# Used only by the one-case indexing script. Use the same local database URL
# as the backend, but never commit this value.
DATABASE_URL=mysql://banteay_user:password@localhost:3306/banteay_digital

# Go to https://aistudio.google.com/api-keys and create your api key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# LLM
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768

# OCR for uploaded scan screenshots. On Windows, point this at the Tesseract
# executable; it may be left unset when `tesseract` is available on PATH.
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
OCR_LANGUAGES=eng
# Optional. Leave blank to use Tesseract's installed language-data directory.
OCR_TESSDATA_DIR=
OCR_TIMEOUT_SECONDS=20
OCR_MAX_IMAGE_BYTES=10485760

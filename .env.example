# Application runtime
ENVIRONMENT=development
PORT=8000

# Internal service authentication. Required when ENVIRONMENT=production.
AI_SERVICE_API_KEY=replace-with-a-long-random-secret

# Future vector knowledge base configuration.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=scam_knowledge_v1

# Future Gemini configuration. Do not commit real keys.
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# The dimension must match the embedding model used when the Qdrant collection
# is created. This service does not create the collection yet.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

